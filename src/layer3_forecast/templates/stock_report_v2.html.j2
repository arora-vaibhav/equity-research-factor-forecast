{% if mtf_snapshots %}
<h2>Multi-timeframe technical analysis (1wk / 1d / 1h)</h2>
<div class="card full" style="margin-bottom: 8px;">
  <div style="color: var(--muted); font-size: 12px;">
    Per-timeframe verdict (TradingView-style aggregate of 17 indicators:
    RSI, MACD, BBands, ADX, Stoch, %R, OBV, MFI, CMF, ATR, SMA50/200,
    EMA9/21, Donchian, price-vs-SMA200). Counts = how many indicators
    fired BUY / SELL / NEUTRAL; net strength is the weight-sum delta.
    Crosses (golden/death, MACD signal cross, Donchian breakout) and
    the SMA200 trend filter carry 1.5x weight.
  </div>
</div>
{# TradingView-style verdict strip -- headline buy/sell/neutral number. #}
{% if ta_panel %}
<div class="card full" style="margin-bottom: 8px; padding: 12px 16px;">
  <div style="display: flex; gap: 24px; flex-wrap: wrap; align-items: center;">
    {% for tf in ['1wk', '1d', '1h'] %}{% set v = ta_panel.get(tf) %}{% if v %}
    <div style="flex: 1 1 200px; min-width: 200px;">
      <div style="font-size: 11px; color: var(--muted); letter-spacing: 1px; text-transform: uppercase;">
        {{ tf }} verdict
      </div>
      <div style="font-size: 22px; font-weight: 700; letter-spacing: 0.5px;
        color: {% if 'STRONG BUY' in v.label %}var(--green-bright)
              {% elif v.label == 'BUY' %}var(--green)
              {% elif 'STRONG SELL' in v.label %}var(--red-bright)
              {% elif v.label == 'SELL' %}var(--red)
              {% else %}var(--fg2){% endif %};">
        {{ v.label }}
      </div>
      <div style="font-size: 12px; color: var(--fg2); margin-top: 2px;" class="num">
        <span style="color: var(--green);">{{ v.buy_count }} buy</span>
        / <span style="color: var(--red);">{{ v.sell_count }} sell</span>
        / <span style="color: var(--muted);">{{ v.neutral_count }} neutral</span>
        &middot; net {{ '{:+.1f}'.format(v.net_strength) }}
      </div>
    </div>
    {% endif %}{% endfor %}
  </div>
</div>
{% endif %}
<div class="grid-3">
  {% for tf in ['1wk', '1d', '1h'] %}
  {% set s = mtf_snapshots.get(tf, {}) %}
  {% set v = ta_panel.get(tf) if ta_panel else None %}
  <div class="card">
    <h3 style="color: var(--accent2); margin-top: 0; display: flex; align-items: baseline; gap: 8px;">
      <span>{{ tf }}</span>
      {% if v %}
      <span style="font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 3px; letter-spacing: 0.4px;
        background: {% if 'STRONG BUY' in v.label %}rgba(74,246,195,0.16)
                    {% elif v.label == 'BUY' %}rgba(38,166,154,0.16)
                    {% elif 'STRONG SELL' in v.label %}rgba(255,67,61,0.18)
                    {% elif v.label == 'SELL' %}rgba(239,83,80,0.16)
                    {% else %}rgba(160,168,184,0.12){% endif %};
        color: {% if 'STRONG BUY' in v.label %}var(--green-bright)
              {% elif v.label == 'BUY' %}var(--green)
              {% elif 'STRONG SELL' in v.label %}var(--red-bright)
              {% elif v.label == 'SELL' %}var(--red)
              {% else %}var(--fg2){% endif %};">
        {{ v.label }}
      </span>
      <span style="font-size: 10px; color: var(--muted);" class="num">
        {{ v.buy_count }}/{{ v.sell_count }}/{{ v.neutral_count }}
      </span>
      {% endif %}
    </h3>
    {% if s.get('available') %}
    <div class="kv"><span class="k">RSI(14)</span>
      <span class="v {% if s.get('rsi_14') and s.rsi_14 > 70 %}neg{% elif s.get('rsi_14') and s.rsi_14 < 30 %}pos{% endif %}">
        {{ '{:.1f}'.format(s.rsi_14) if s.get('rsi_14') is not none else '-' }}</span></div>
    <div class="kv"><span class="k">MACD hist</span>
      <span class="v {% if s.get('macd_hist') and s.macd_hist >= 0 %}pos{% else %}neg{% endif %}">{{ '{:+.4f}'.format(s.macd_hist) if s.get('macd_hist') is not none else '-' }}</span></div>
    <div class="kv"><span class="k">Bollinger %b</span>
      <span class="v">{{ '{:.2f}'.format(s.bb_pctb) if s.get('bb_pctb') is not none else '-' }}{% if s.get('bb_squeeze') %} <span class="tag tag-orange">SQUEEZE</span>{% endif %}</span></div>
    <div class="kv"><span class="k">ADX(14)</span>
      <span class="v">{{ '{:.1f}'.format(s.adx_14) if s.get('adx_14') is not none else '-' }}{% if s.get('adx_rising') %} <span class="tag tag-blue">RISING</span>{% endif %}</span></div>
    <div class="kv"><span class="k">ATR %</span>
      <span class="v">{{ '{:.2%}'.format(s.atr_pct) if s.get('atr_pct') is not none else '-' }}</span></div>
    <div class="kv"><span class="k">MFI(14) / CMF(20)</span>
      <span class="v">{{ '{:.1f}'.format(s.mfi_14) if s.get('mfi_14') is not none else '-' }}
        / {{ '{:+.3f}'.format(s.cmf_20) if s.get('cmf_20') is not none else '-' }}</span></div>
    <div class="kv"><span class="k">Donchian pos / break</span>
      <span class="v">{{ '{:.2f}'.format(s.donch_pos_20) if s.get('donch_pos_20') is not none else '-' }}{% if s.get('donch_break_up') %} <span class="tag tag-green">UP</span>{% endif %}{% if s.get('donch_break_dn') %} <span class="tag tag-red">DN</span>{% endif %}</span></div>
    {% if s.get('price_above_sma200') is defined %}
    <div class="kv"><span class="k">vs SMA200</span>
      <span class="v">{% if s.price_above_sma200 %}<span class="tag tag-green">ABOVE</span>{% else %}<span class="tag tag-red">BELOW</span>{% endif %}</span></div>
    {% endif %}
    <div class="kv"><span class="k">n_bars</span><span class="v">{{ s.get('n_bars', '-') }}</span></div>
    {% else %}
    <div style="color: var(--muted); font-size: 12px;">no data (yfinance interval may exceed lookback cap)</div>
    {% endif %}
  </div>
  {% endfor %}
</div>
{% if mtf_confluence %}
<div class="card full" style="margin-top: 8px;">
  <h3 style="color: var(--accent2); margin-top: 0;">Cross-timeframe confluence</h3>
  <div class="kv"><span class="k">Confluence LONG (0-1)</span>
    <span class="v {% if mtf_confluence.get('confluence_long', 0) > 0 %}pos{% else %}muted{% endif %}">{{ '{:.2f}'.format(mtf_confluence.get('confluence_long', 0.0)) }}</span></div>
  <div class="kv"><span class="k">Confluence SHORT (0-1)</span>
    <span class="v {% if mtf_confluence.get('confluence_short', 0) > 0 %}neg{% else %}muted{% endif %}">{{ '{:.2f}'.format(mtf_confluence.get('confluence_short', 0.0)) }}</span></div>

  <div style="color: var(--muted); font-size: 11px; margin-top: 10px;">
    Patterns are intentionally selective (Elder triple-screen, daily/hourly
    divergence, BB-squeeze+breakout, SMA-alignment, MACD/OBV). Most tickers
    fire 0-2 patterns on any given day. Below: each pattern with its
    current state (&#x2713; firing / &#x2717; not firing).
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; margin-top: 10px;">
    <div>
      <div style="font-size: 10px; color: var(--green); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">Long patterns</div>
      {% for k, v in mtf_confluence.items() %}{% if k.startswith('long_') %}
      <div style="display: flex; gap: 8px; align-items: center; padding: 3px 0; font-size: 11px;">
        <span style="color: {% if v == 1 %}var(--green-bright){% else %}var(--muted){% endif %}; width: 12px;">{% if v == 1 %}&#x2713;{% else %}&#x2717;{% endif %}</span>
        <span style="color: {% if v == 1 %}var(--fg){% else %}var(--fg2){% endif %}; font-family: var(--font-mono);">{{ k[5:] }}</span>
      </div>
      {% endif %}{% endfor %}
    </div>
    <div>
      <div style="font-size: 10px; color: var(--red); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">Short patterns</div>
      {% for k, v in mtf_confluence.items() %}{% if k.startswith('short_') %}
      <div style="display: flex; gap: 8px; align-items: center; padding: 3px 0; font-size: 11px;">
        <span style="color: {% if v == 1 %}var(--red-bright){% else %}var(--muted){% endif %}; width: 12px;">{% if v == 1 %}&#x2713;{% else %}&#x2717;{% endif %}</span>
        <span style="color: {% if v == 1 %}var(--fg){% else %}var(--fg2){% endif %}; font-family: var(--font-mono);">{{ k[6:] }}</span>
      </div>
      {% endif %}{% endfor %}
    </div>
  </div>
</div>
{% endif %}
{% endif %}


<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ ticker }} - Trade Identifier v2 - {{ as_of_date }}</title>
<style>
  :root {
    /* Bloomberg-Terminal modernised dark (v8) */
    --bg: #08090d; --bg2: #0d1017; --bg3: #131722; --bg-card: #161a25;
    --fg: #e6e9ef; --fg2: #a0a8b8; --muted: #6b7280;
    --accent: #4d9fff; --accent2: #f39f41;
    --green: #26a69a; --green-bright: #4af6c3;
    --red: #ef5350; --red-bright: #ff433d;
    --orange: #fb8b1e; --cyan: #4af6c3; --warn: #f5c842;
    --border: rgba(255,255,255,0.06); --border-strong: rgba(255,255,255,0.12);
    --font-mono: 'JetBrains Mono', 'SF Mono', 'Cascadia Code', 'Consolas', ui-monospace, monospace;
  }
  * { box-sizing: border-box; }
  body { background: var(--bg); color: var(--fg); margin: 0; padding: 20px;
         font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", system-ui, sans-serif;
         font-size: 13px; font-weight: 500; line-height: 1.5;
         -webkit-font-smoothing: antialiased;
         font-feature-settings: 'tnum', 'cv11';
         max-width: 1400px; margin: 0 auto; }
  .num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  h1 { color: var(--fg); font-size: 28px; margin-bottom: 4px; }
  h2 { color: var(--accent); font-size: 18px; margin-top: 28px;
       border-bottom: 1px solid var(--bg3); padding-bottom: 6px; }
  .meta { color: var(--muted); font-size: 13px; margin-bottom: 12px; }
  .meta strong { color: var(--fg2); }
  .banner-warn { background: #7c1f1f; color: #fff; padding: 12px;
                 border-radius: 6px; margin-bottom: 16px; font-weight: 600; }
  .banner-info { background: var(--bg2); border: 1px solid var(--bg3);
                 padding: 10px 12px; border-radius: 6px; margin-bottom: 14px;
                 color: var(--fg2); font-size: 13px; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
  .card { background: var(--bg2); border: 1px solid var(--bg3);
          border-radius: 8px; padding: 14px; }
  .card.full { width: 100%; }
  .kv { display: flex; justify-content: space-between; padding: 4px 0;
        border-bottom: 1px solid var(--bg3); font-size: 13px; }
  .kv:last-child { border-bottom: none; }
  .kv .k { color: var(--muted); }
  .kv .v { color: var(--fg); font-weight: 500; }
  .pos { color: var(--green); font-weight: 600; }
  .neg { color: var(--red); font-weight: 600; }
  .warn { color: var(--warn); font-weight: 600; }
  .tag { display: inline-block; padding: 2px 8px; border-radius: 4px;
         font-size: 11px; font-weight: 600; }
  .tag-green { background: #2a3a23; color: var(--green); }
  .tag-red { background: #3a2330; color: var(--red); }
  .tag-blue { background: #1f2a44; color: var(--accent); }
  .tag-orange { background: #3a2e1c; color: var(--orange); }
  table { width: 100%; border-collapse: collapse; font-size: 13px;
          margin-top: 8px; }
  th, td { padding: 6px 8px; text-align: left;
           border-bottom: 1px solid var(--bg3); }
  th { background: var(--bg3); color: var(--fg2);
       text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; }
  tbody tr:hover { background: var(--bg3); }
  .narrative-card { background: var(--bg2); border-left: 3px solid var(--accent);
                    padding: 12px 14px; margin-bottom: 8px; border-radius: 4px; }
  .narrative-card.bull { border-left-color: var(--green); }
  .narrative-card.bear { border-left-color: var(--red); }
  .narrative-card.syn { border-left-color: var(--accent2); }
  .narrative-card h3 { color: var(--fg); font-size: 13px; margin: 0 0 6px 0;
                       text-transform: uppercase; letter-spacing: 0.6px; }
  .risk-list { margin: 0; padding-left: 18px; color: var(--orange); }
  .risk-list li { margin: 4px 0; }
  .footer { margin-top: 36px; padding-top: 14px; border-top: 1px solid var(--bg3);
            color: var(--muted); font-size: 11px; }
  /* Mobile (phone) responsive overrides */
  @media (max-width: 768px) {
    body { padding: 12px; font-size: 14px; }
    h1 { font-size: 22px; }
    h2 { font-size: 16px; margin-top: 22px; }
    .grid-2, .grid-3 { grid-template-columns: 1fr; }
    .card { padding: 10px; }
    .kv { font-size: 12px; flex-direction: column; }
    .kv .k { color: var(--muted); font-size: 11px; margin-bottom: 2px; }
    .kv .v { font-size: 13px; }
    table { font-size: 11px; }
    th, td { padding: 4px 5px; }
    /* Force horizontal scroll on wide tables instead of wrap-mess */
    .card.full { overflow-x: auto; }
    .meta { font-size: 11px; line-height: 1.6; }
    .meta strong { display: inline-block; margin-right: 4px; }
  }
  @media (max-width: 480px) {
    h1 { font-size: 18px; }
    h2 { font-size: 14px; }
    .meta { font-size: 10px; }
  }
</style>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>

{% if is_synthetic %}
<div class="banner-warn">
  &#9888; SYNTHETIC-MODE REPORT &mdash; numbers are illustrative only and DO NOT reflect live market data.
</div>
{% endif %}

<h1>{{ ticker }}{% if company_name %} &mdash; {{ company_name }}{% endif %}</h1>
<div class="meta">
  <strong>Report date:</strong> {{ as_of_date }} &nbsp;|&nbsp;
  <strong>Sector:</strong> {{ sector or 'unknown' }} &nbsp;|&nbsp;
  <strong>Last price:</strong> ${{ '{:,.2f}'.format(last_price) }} &nbsp;|&nbsp;
  <strong>Horizon:</strong> {{ horizon_days }}d &nbsp;|&nbsp;
  <strong>Generated:</strong> {{ generated_at }}
</div>

{% if not beats_random_walk %}
<div class="banner-info" style="color: var(--warn);">
  &#9888; Ensemble forecast does NOT meaningfully beat the random-walk baseline. Model edge is unclear; weight conviction accordingly.
</div>
{% endif %}

<h2>Forecast summary</h2>
<div class="grid-3">
  <div class="card">
    <div class="kv"><span class="k">Ensemble point</span>
      <span class="v {% if ensemble_point >= 0 %}pos{% else %}neg{% endif %}">{{ '{:+.2%}'.format(ensemble_point) }}</span></div>
    <div class="kv"><span class="k">80% CI</span>
      <span class="v">[{{ '{:+.2%}'.format(ensemble_lower_80) }}, {{ '{:+.2%}'.format(ensemble_upper_80) }}]</span></div>
    <div class="kv"><span class="k">95% CI</span>
      <span class="v">[{{ '{:+.2%}'.format(ensemble_lower_95) }}, {{ '{:+.2%}'.format(ensemble_upper_95) }}]</span></div>
    <div class="kv"><span class="k">Method dispersion</span>
      <span class="v">{{ '{:.4f}'.format(method_dispersion) }}</span></div>
    <div class="kv"><span class="k">Beats RW baseline</span>
      <span class="v {% if beats_random_walk %}pos{% else %}warn{% endif %}">{{ 'YES' if beats_random_walk else 'NO' }}</span></div>
  </div>
  <div class="card">
    <div class="kv"><span class="k">MC drift (annual)</span>
      <span class="v">{{ '{:.2%}'.format(mc_drift) if mc_drift is not none else '-' }}</span></div>
    <div class="kv"><span class="k">MC sigma (annual)</span>
      <span class="v">{{ '{:.2%}'.format(mc_sigma) if mc_sigma is not none else '-' }}</span></div>
    <div class="kv"><span class="k">MC paths</span>
      <span class="v">{{ mc_n_paths }}</span></div>
    <div class="kv"><span class="k">Bull target (90th pct)</span>
      <span class="v pos">{{ '{:+.2%}'.format(bull_scenario_return) }} -> ${{ '{:,.2f}'.format(last_price * (1.0 + bull_scenario_return)) }}</span></div>
    <div class="kv"><span class="k">Base target (50th)</span>
      <span class="v">{{ '{:+.2%}'.format(base_scenario_return) }} -> ${{ '{:,.2f}'.format(last_price * (1.0 + base_scenario_return)) }}</span></div>
    <div class="kv"><span class="k">Bear target (10th pct)</span>
      <span class="v neg">{{ '{:+.2%}'.format(bear_scenario_return) }} -> ${{ '{:,.2f}'.format(last_price * (1.0 + bear_scenario_return)) }}</span></div>
  </div>
  <div class="card">
    <div class="kv"><span class="k">Macro regime</span>
      <span class="v"><span class="tag {% if macro.macro_regime == 'risk_off' %}tag-red{% elif macro.macro_regime == 'risk_on_growth' %}tag-green{% elif macro.macro_regime == 'risk_on_late' %}tag-orange{% else %}tag-blue{% endif %}">{{ macro.macro_regime }}</span></span></div>
    <div class="kv"><span class="k">10y yield</span>
      <span class="v">{{ '{:.2f}%'.format(macro.tnx_yield) if macro.tnx_yield == macro.tnx_yield else '-' }}</span></div>
    <div class="kv"><span class="k">3m yield</span>
      <span class="v">{{ '{:.2f}%'.format(macro.irx_yield) if macro.irx_yield == macro.irx_yield else '-' }}</span></div>
    <div class="kv"><span class="k">Yield-curve slope</span>
      <span class="v">{{ '{:+.2f}%'.format(macro.yield_curve_slope) if macro.yield_curve_slope == macro.yield_curve_slope else '-' }}</span></div>
    <div class="kv"><span class="k">VIX level</span>
      <span class="v">{{ '{:.2f}'.format(macro.vix_level) if macro.vix_level == macro.vix_level else '-' }}</span></div>
    <div class="kv"><span class="k">VIX z-score (252d)</span>
      <span class="v">{{ '{:+.2f}'.format(macro.vix_z_score_252d) if macro.vix_z_score_252d == macro.vix_z_score_252d else '-' }}</span></div>
    <div class="kv"><span class="k">Sector ETF</span>
      <span class="v">{{ macro.sector_etf or '-' }}</span></div>
    <div class="kv"><span class="k">Sector relative (90d)</span>
      <span class="v">{{ '{:+.2%}'.format(macro.sector_relative_return_90d) if macro.sector_relative_return_90d == macro.sector_relative_return_90d else '-' }}</span></div>
  </div>
</div>

<h2>Forecast plot (interactive)</h2>
<div class="card full">{{ forecast_fan_html | safe }}</div>

<h2>Realised volatility</h2>
<div class="card full">
  <div class="kv"><span class="k">Yang-Zhang annualized (60d)</span>
    <span class="v">{{ '{:.2%}'.format(realized_vol_yang_zhang) if realized_vol_yang_zhang is not none else '-' }}</span></div>
  <div class="kv"><span class="k">Close-to-close annualized (60d)</span>
    <span class="v">{{ '{:.2%}'.format(realized_vol_close_to_close) if realized_vol_close_to_close is not none else '-' }}</span></div>
</div>

<h2>Per-method comparison</h2>
<div class="card full">
  <table>
    <thead><tr><th>Method</th><th>Weight</th><th>Point</th><th>80% lo</th><th>80% hi</th><th>95% lo</th><th>95% hi</th></tr></thead>
    <tbody>
    {% for m in method_rows %}
      <tr>
        <td><span class="tag tag-blue">{{ m.method }}</span></td>
        <td>{{ '{:.1%}'.format(m.weight) }}</td>
        <td class="{% if m.point_return >= 0 %}pos{% else %}neg{% endif %}">{{ '{:+.2%}'.format(m.point_return) }}</td>
        <td>{{ '{:+.2%}'.format(m.lower_80) }}</td>
        <td>{{ '{:+.2%}'.format(m.upper_80) }}</td>
        <td>{{ '{:+.2%}'.format(m.lower_95) }}</td>
        <td>{{ '{:+.2%}'.format(m.upper_95) }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>

<h2>Factor contributions (interactive waterfall)</h2>
<div class="card full">{{ waterfall_html | safe }}</div>

<h2>Factor contribution table</h2>
<div class="card full">
  <table>
    <thead><tr><th>Factor</th><th>Loading</th><th>Ticker value</th><th>Contribution</th></tr></thead>
    <tbody>
    {% for r in factor_table %}
      <tr>
        <td>{{ r.factor }}</td>
        <td>{{ '{:+.4f}'.format(r.loading) if r.loading is not none else '-' }}</td>
        <td>{{ '{:+.4f}'.format(r.value) if r.value is not none else '-' }}</td>
        <td class="{% if r.contribution >= 0 %}pos{% else %}neg{% endif %}">{{ '{:+.4f}'.format(r.contribution) }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>

<h2>Factor decay over horizon</h2>
<div class="card full">{{ decay_html | safe }}</div>

{% if ic_html %}
<h2>Factor IC over time</h2>
<div class="card full">{{ ic_html | safe }}</div>
{% endif %}

{% if ic_table_rows %}
<h2>Per-factor IC backtest summary</h2>
<div class="card full">
  <table>
    <thead><tr><th>Factor</th><th>Mean IC</th><th>ICIR</th><th>% positive</th><th>Cumulative attribution</th><th>n periods</th></tr></thead>
    <tbody>
    {% for r in ic_table_rows %}
      <tr>
        <td>{{ r.factor }}</td>
        <td class="{% if r.mean_ic and r.mean_ic > 0 %}pos{% elif r.mean_ic and r.mean_ic < 0 %}neg{% endif %}">{{ '{:+.4f}'.format(r.mean_ic) if r.mean_ic is not none else '-' }}</td>
        <td>{{ '{:+.3f}'.format(r.icir) if r.icir is not none else '-' }}</td>
        <td>{{ '{:.1%}'.format(r.fraction_positive) if r.fraction_positive is not none else '-' }}</td>
        <td>{{ '{:+.4f}'.format(r.cumulative_attribution) if r.cumulative_attribution is not none else '-' }}</td>
        <td>{{ r.n_periods if r.n_periods is not none else '-' }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{% if descriptive_stats %}
<h2>Snapshot &mdash; fundamentals + technical</h2>
<div class="grid-3">
  <div class="card">
    <div class="kv"><span class="k">Market cap</span>
      <span class="v">{{ descriptive_stats.market_cap_display or '-' }}</span></div>
    <div class="kv"><span class="k">P/E (trailing)</span>
      <span class="v">{{ descriptive_stats.pe or '-' }}</span></div>
    <div class="kv"><span class="k">P/B</span>
      <span class="v">{{ descriptive_stats.pb or '-' }}</span></div>
    <div class="kv"><span class="k">Forward P/E</span>
      <span class="v">{{ descriptive_stats.forward_pe or '-' }}</span></div>
    <div class="kv"><span class="k">PEG</span>
      <span class="v">{{ descriptive_stats.peg or '-' }}</span></div>
    <div class="kv"><span class="k">Dividend yield</span>
      <span class="v">{{ descriptive_stats.dividend_yield or '-' }}</span></div>
    <div class="kv"><span class="k">Beta</span>
      <span class="v">{{ descriptive_stats.beta or '-' }}</span></div>
  </div>
  <div class="card">
    <div class="kv"><span class="k">52w high / low</span>
      <span class="v">{{ descriptive_stats.fifty_two_week_high or '-' }} / {{ descriptive_stats.fifty_two_week_low or '-' }}</span></div>
    <div class="kv"><span class="k">Distance from 52w high</span>
      <span class="v">{{ descriptive_stats.distance_from_52w_high or '-' }}</span></div>
    <div class="kv"><span class="k">RSI(14)</span>
      <span class="v">{{ descriptive_stats.rsi_14 or '-' }}</span></div>
    <div class="kv"><span class="k">SMA50 / SMA200</span>
      <span class="v">{{ descriptive_stats.sma50 or '-' }} / {{ descriptive_stats.sma200 or '-' }}</span></div>
    <div class="kv"><span class="k">ATR(14)</span>
      <span class="v">{{ descriptive_stats.atr_14 or '-' }}</span></div>
    <div class="kv"><span class="k">Avg volume (20d)</span>
      <span class="v">{{ descriptive_stats.avg_volume or '-' }}</span></div>
  </div>
  <div class="card">
    <div class="kv"><span class="k">Profit margin</span>
      <span class="v">{{ descriptive_stats.profit_margin or '-' }}</span></div>
    <div class="kv"><span class="k">ROE</span>
      <span class="v">{{ descriptive_stats.roe or '-' }}</span></div>
    <div class="kv"><span class="k">Revenue growth (YoY)</span>
      <span class="v">{{ descriptive_stats.revenue_growth or '-' }}</span></div>
    <div class="kv"><span class="k">Earnings growth (YoY)</span>
      <span class="v">{{ descriptive_stats.earnings_growth or '-' }}</span></div>
    <div class="kv"><span class="k">Debt/Equity</span>
      <span class="v">{{ descriptive_stats.debt_to_equity or '-' }}</span></div>
    <div class="kv"><span class="k">Current ratio</span>
      <span class="v">{{ descriptive_stats.current_ratio or '-' }}</span></div>
    <div class="kv"><span class="k">Short ratio</span>
      <span class="v">{{ descriptive_stats.short_ratio or '-' }}</span></div>
  </div>
</div>
{% endif %}

{% if walk_forward and walk_forward.horizons %}
<h2>Forecast accuracy &mdash; walk-forward backtest (60d lookback)</h2>
<div class="banner-info">
  Walk-forward backtest on this ticker's last ~3 years of price history. For each anchor t,
  we re-fit on the previous 60 days and predict t+1 / t+30 / t+60. Then we compare to the
  realised price. Reference benchmark: PMC9680880 LASSO-LSTM on AAPL/MSFT/BAC = 71.6%-77.2%
  1d directional accuracy. n_walks = {{ walk_forward.n_walks }}.
</div>
<div class="card full">
  <table>
    <thead><tr><th>Horizon</th><th>n predictions</th><th>Directional accuracy</th><th>MAE (return)</th><th>RMSE</th><th>80% CI hit rate</th><th>Pearson(pred, real)</th></tr></thead>
    <tbody>
    {% for h in walk_forward.horizons %}
      <tr>
        <td><b>{{ h.horizon_days }}d</b></td>
        <td>{{ h.n_predictions }}</td>
        <td class="{% if h.directional_accuracy > 0.55 %}pos{% elif h.directional_accuracy < 0.45 %}neg{% endif %}">{{ '{:.1%}'.format(h.directional_accuracy) }}</td>
        <td>{{ '{:.2%}'.format(h.mae_return) }}</td>
        <td>{{ '{:.2%}'.format(h.rmse_return) }}</td>
        <td>{{ '{:.1%}'.format(h.ci80_hit_rate) }}</td>
        <td class="{% if h.pearson_pred_vs_realized > 0 %}pos{% else %}neg{% endif %}">{{ '{:+.3f}'.format(h.pearson_pred_vs_realized) }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{% if volume_composite and volume_composite.get('n_signals', 0) > 0 %}
<h2>Volume momentum (Granville / CGW / Quong-Soudack)</h2>
<div class="banner-info">
  Volume confirms price moves (Campbell-Grossman-Wang 1993 <i>RFS</i>). High-volume moves are more
  informative than low-volume moves. Composite z-score is the mean of standardised features clipped
  to &plusmn;3 (Grinold-Kahn 2000 ch.3).
</div>
<div class="grid-3">
  <div class="card">
    <div class="kv"><span class="k">Composite z</span>
      <span class="v {% if volume_composite.get('composite', 0) >= 0 %}pos{% else %}neg{% endif %}">{{ '{:+.3f}'.format(volume_composite.get('composite', 0.0)) }}</span></div>
    <div class="kv"><span class="k">Active signals</span>
      <span class="v">{{ volume_composite.get('n_signals', 0) }} of 7</span></div>
    <div class="kv"><span class="k">MFI(14)</span>
      <span class="v">{{ '{:.2f}'.format(volume_composite.get('mfi', 0.0)) if volume_composite.get('mfi') is not none else '-' }}</span></div>
    <div class="kv"><span class="k">CMF(20)</span>
      <span class="v">{{ '{:+.4f}'.format(volume_composite.get('cmf', 0.0)) if volume_composite.get('cmf') is not none else '-' }}</span></div>
  </div>
  <div class="card">
    <div class="kv"><span class="k">OBV z (252d)</span>
      <span class="v">{{ '{:+.3f}'.format(volume_composite.get('obv_z', 0.0)) if volume_composite.get('obv_z') is not none else '-' }}</span></div>
    <div class="kv"><span class="k">VPT z (252d)</span>
      <span class="v">{{ '{:+.3f}'.format(volume_composite.get('vpt_z', 0.0)) if volume_composite.get('vpt_z') is not none else '-' }}</span></div>
    <div class="kv"><span class="k">VW-momentum z</span>
      <span class="v">{{ '{:+.3f}'.format(volume_composite.get('vwmom_z', 0.0)) if volume_composite.get('vwmom_z') is not none else '-' }}</span></div>
  </div>
  <div class="card">
    <div class="kv"><span class="k">Volume z (60d)</span>
      <span class="v">{{ '{:+.3f}'.format(volume_composite.get('volume_z_z', 0.0)) if volume_composite.get('volume_z_z') is not none else '-' }}</span></div>
    <div class="kv"><span class="k">Relative volume (vs 20d ADV)</span>
      <span class="v">{{ '{:.2f}x'.format(volume_composite.get('rel_volume', 0.0)) if volume_composite.get('rel_volume') is not none else '-' }}</span></div>
    <div class="kv"><span class="k">CMF z (252d)</span>
      <span class="v">{{ '{:+.3f}'.format(volume_composite.get('cmf_z', 0.0)) if volume_composite.get('cmf_z') is not none else '-' }}</span></div>
  </div>
</div>
{% endif %}

{% if sector_features %}
<h2>Sector rotation &amp; AI-spillover (v6)</h2>
<div class="grid-3">
  <div class="card">
    <div class="kv"><span class="k">Sector ETF</span>
      <span class="v">{{ sector_features.sector_etf or '-' }}</span></div>
    <div class="kv"><span class="k">Rel-return 5d / 20d / 60d</span>
      <span class="v">
        {{ '{:+.2%}'.format(sector_features.rel_ret_5d) if sector_features.rel_ret_5d == sector_features.rel_ret_5d else '-' }}
        / {{ '{:+.2%}'.format(sector_features.rel_ret_20d) if sector_features.rel_ret_20d == sector_features.rel_ret_20d else '-' }}
        / {{ '{:+.2%}'.format(sector_features.rel_ret_60d) if sector_features.rel_ret_60d == sector_features.rel_ret_60d else '-' }}
      </span></div>
    <div class="kv"><span class="k">Sector mom-z 1m / 3m / 6m</span>
      <span class="v">
        {{ '{:+.2f}'.format(sector_features.sector_mom_1m_z) if sector_features.sector_mom_1m_z == sector_features.sector_mom_1m_z else '-' }}
        / {{ '{:+.2f}'.format(sector_features.sector_mom_3m_z) if sector_features.sector_mom_3m_z == sector_features.sector_mom_3m_z else '-' }}

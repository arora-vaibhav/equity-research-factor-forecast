    <div class="kv"><span class="k">Sector dispersion 20d</span>
      <span class="v">{{ '{:.4f}'.format(sector_features.sector_dispersion_20d) if sector_features.sector_dispersion_20d == sector_features.sector_dispersion_20d else '-' }}</span></div>
  </div>
</div>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ ticker }} - Trade Identifier Stock Report - {{ as_of_date }}</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 24px; color: #1d1d1f; max-width: 1000px; }
  h1 { font-size: 28px; margin-bottom: 4px; }
  h2 { font-size: 18px; margin-top: 32px; border-bottom: 1px solid #ddd; padding-bottom: 6px; }
  .meta { color: #555; font-size: 14px; margin-bottom: 16px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .card { border: 1px solid #e0e0e0; border-radius: 8px; padding: 12px; background: #fafafa; }
  .pos { color: #0a7d2f; font-weight: 600; }
  .neg { color: #b00020; font-weight: 600; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { padding: 6px 8px; text-align: left; border-bottom: 1px solid #eee; }
  th { background: #f0f0f0; }
  .plot img { width: 100%; height: auto; }
  .footer { margin-top: 40px; font-size: 12px; color: #888; border-top: 1px solid #eee; padding-top: 12px; }
</style>
</head>
<body>

<h1>{{ ticker }}{% if company_name %} &mdash; {{ company_name }}{% endif %}</h1>
<div class="meta">
  <strong>Report date:</strong> {{ as_of_date }} &nbsp;|&nbsp;
  <strong>Sector:</strong> {{ sector or 'unknown' }} &nbsp;|&nbsp;
  <strong>Forecast horizon:</strong> {{ horizon_days }} days &nbsp;|&nbsp;
  <strong>Generated:</strong> {{ generated_at }}
</div>

<h2>Forecast summary</h2>
<div class="grid">
  <div class="card">
    <div><strong>Point return:</strong>
      {% if point_return >= 0 %}
        <span class="pos">+{{ '{:.2%}'.format(point_return) }}</span>
      {% else %}
        <span class="neg">{{ '{:.2%}'.format(point_return) }}</span>
      {% endif %}
    </div>
    <div><strong>80% CI:</strong> [{{ '{:.2%}'.format(lower_80) }}, {{ '{:.2%}'.format(upper_80) }}]</div>
    <div><strong>95% CI:</strong> [{{ '{:.2%}'.format(lower_95) }}, {{ '{:.2%}'.format(upper_95) }}]</div>
    <div><strong>Training observations:</strong> {{ n_train }}</div>
    <div><strong>Bootstrap samples:</strong> {{ n_bootstrap }}</div>
  </div>
  <div class="card plot">
    {% if plot_b64 %}
      <img src="data:image/png;base64,{{ plot_b64 }}" alt="forecast plot">
    {% else %}
      <em>(no plot)</em>
    {% endif %}
  </div>
</div>

<h2>Factor contributions</h2>
<table>
  <thead><tr><th>Factor</th><th>Loading (regression)</th><th>Ticker value</th><th>Contribution (decimal)</th></tr></thead>
  <tbody>
  {% for row in factor_table %}
    <tr>
      <td>{{ row.factor }}</td>
      <td>{{ '{:+.4f}'.format(row.loading) if row.loading is not none else '-' }}</td>
      <td>{{ '{:+.4f}'.format(row.value) if row.value is not none else '-' }}</td>
      <td>
        {% if row.contribution >= 0 %}<span class="pos">+{{ '{:.4f}'.format(row.contribution) }}</span>
        {% else %}<span class="neg">{{ '{:.4f}'.format(row.contribution) }}</span>{% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<h2>Catalysts in window ({{ horizon_days }}d)</h2>
{% if catalysts %}
<table>
  <thead><tr><th>Date</th><th>Type</th><th>Source</th><th>Confidence</th><th>Description</th></tr></thead>
  <tbody>
  {% for cat in catalysts %}
    <tr>
      <td>{{ cat.catalyst_date }}</td>
      <td>{{ cat.catalyst_type }}</td>
      <td>{{ cat.source }}</td>
      <td>{{ cat.confidence }}</td>
      <td>{{ cat.catalyst_description or '' }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<em>No catalysts within the forecast window.</em>
{% endif %}

<h2>Reasoning</h2>
<p>{{ reasoning_text or 'No reasoning available.' }}</p>

<div class="footer">
  Generated by Trade Identifier Forecast Layer (forecast version {{ forecast_version }}).
  Linear multi-factor regression + bootstrapped intervals (Gu/Kelly/Xiu 2020 RFS;
  Krauss/Do/Huck 2017 EJOR; Efron 1979 bootstrap). Not investment advice.
</div>

</body>
</html>

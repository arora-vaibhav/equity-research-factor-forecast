# Copy this file to `.env` and fill in the values you have access to.
# All of these are optional; the data adapters degrade gracefully when a key is
# missing. With NO keys set, the project still works against the free sources
# (Finviz scrape, Yahoo Finance via yfinance, SEC EDGAR direct).

# ---------- Required by some data adapters ----------

# SEC EDGAR requires a User-Agent header identifying who is making requests.
# Format: "App Name your-email@example.com"
SEC_EDGAR_USER_AGENT=Equity Research Factor Forecast research@example.com

# ---------- Optional: paid / freemium data providers ----------

# FRED - free, register at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Financial Modeling Prep - freemium, register at https://site.financialmodelingprep.com
# Free tier covers mega-caps only; without this the FMP adapter falls back to yfinance.
FMP_API_KEY=

# Polygon.io - freemium, options chain history. https://polygon.io
POLYGON_API_KEY=

# Tiingo - freemium, equity fundamentals. https://api.tiingo.com
TIINGO_API_KEY=

# Intrinio - paid, institutional-grade. https://intrinio.com
INTRINIO_API_KEY=

# ---------- Optional: report enrichment ----------

# Anthropic Claude API - enables LLM-generated narrative paragraphs in the
# per-ticker forecast reports. The reports render fine without this.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---------- Optional: local overrides ----------

# Override the local SQLite cache database location. Default: data/cache.sqlite
# TI_CACHE_DB=data/cache.sqlite

